# Route everything that is not a real file through index.php
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # one address for search engines: www.dezservis.kz → dezservis.kz
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  # pages of the old Tilda site → home page instead of «not found»
  RewriteRule ^(page[0-9]+\.html|tpost/.*|tproduct/.*)$ / [R=301,L]
  RewriteRule ^(storage|app)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|svg|png|jpe?g|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # fonts never change; css/js links carry ?v=<file time>, so a new version gets a new address
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>
